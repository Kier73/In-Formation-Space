{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/experiments/external_neural_structure_reading/gpt2-operation-graph.schema.json",
  "title": "HFR-001 GPT-2 Operation Graph v0.1",
  "description": "A family-specific inferred graph checked against an NSD v0.1 configuration and tensor manifest. It is not a functional execution trace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_observation",
    "family",
    "family_semantics",
    "dimensions",
    "nodes",
    "verification",
    "interpretation_reference",
    "assumptions_and_unresolved",
    "evidence_boundary"
  ],
  "properties": {
    "schema": {
      "const": "in-formation-space.gpt2-operation-graph.v0.1"
    },
    "source_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "license_id"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license_id": {"type": ["string", "null"]}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "architecture", "adapter", "interpretation_status"],
      "properties": {
        "model_type": {"const": "gpt2"},
        "architecture": {"const": "GPT2LMHeadModel"},
        "adapter": {"type": "string"},
        "interpretation_status": {"const": "inferred-family-graph"}
      }
    },
    "family_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_function", "attention_scaling", "tied_output_embeddings"],
      "properties": {
        "activation_function": {
          "$ref": "#/$defs/semantic-value"
        },
        "attention_scaling": {
          "$ref": "#/$defs/semantic-value"
        },
        "tied_output_embeddings": {
          "$ref": "#/$defs/semantic-value"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary_size",
        "hidden_width",
        "layer_count",
        "attention_head_count",
        "attention_head_width",
        "context_length",
        "mlp_intermediate_width",
        "mlp_intermediate_width_basis",
        "parameter_dtypes"
      ],
      "properties": {
        "vocabulary_size": {"type": "integer", "minimum": 1},
        "hidden_width": {"type": "integer", "minimum": 1},
        "layer_count": {"type": "integer", "minimum": 1},
        "attention_head_count": {"type": "integer", "minimum": 1},
        "attention_head_width": {"type": "integer", "minimum": 1},
        "context_length": {"type": "integer", "minimum": 1},
        "mlp_intermediate_width": {"type": "integer", "minimum": 1},
        "mlp_intermediate_width_basis": {"type": "string"},
        "parameter_dtypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed_checks", "failed_checks", "checked_transformer_blocks", "checks"],
      "properties": {
        "status": {"const": "passed"},
        "passed_checks": {"type": "integer", "minimum": 1},
        "failed_checks": {"const": 0},
        "checked_transformer_blocks": {"type": "integer", "minimum": 1},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "evidence"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"const": "passed"},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "interpretation_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "checked_on", "used_for"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "checked_on": {"type": "string", "format": "date"},
        "used_for": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "assumptions_and_unresolved": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "semantic-value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_basis"],
      "properties": {
        "value": {
          "oneOf": [
            {"type": "string"},
            {"type": "boolean"}
          ]
        },
        "evidence_basis": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "shape", "dtype", "evidence_basis"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "shape": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "dtype": {"type": "string", "minLength": 1},
        "evidence_basis": {"type": "string", "minLength": 1},
        "view": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operator", "inputs", "outputs", "attributes", "tensor_bindings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "attributes": {"type": "object"},
        "tensor_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/binding"}
        }
      }
    }
  }
}
