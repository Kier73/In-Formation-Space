{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOR-002 source-followup attestation predicate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "role", "event_id", "repository", "run_id", "run_attempt", "workflow_ref", "workflow_sha", "git_ref", "git_sha", "job", "actor_id", "record_sha256", "signed_digest", "handoff_envelope_digest", "transferred_in_handoff"],
  "properties": {
    "schema": {"const": "in-formation.mor002-followup-predicate/0.1"},
    "role": {"const": "client_host"},
    "event_id": {"const": "A2"},
    "repository": {"const": "Kier73/In-Formation-Space"},
    "run_id": {"type": "string"},
    "run_attempt": {"type": "string"},
    "workflow_ref": {"type": "string"},
    "workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_ref": {"const": "refs/heads/main"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "job": {"const": "client_host"},
    "actor_id": {"type": "string"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signed_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "handoff_envelope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transferred_in_handoff": {"const": false}
  }
}