{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/experiments/multi-observer-causal-reconstruction/report.schema.json",
  "title": "Multi-observer causal reconstruction report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "path_id", "attempt_id", "repository", "run_id", "run_attempt", "workflow_ref", "workflow_sha", "hosts", "verifier", "host_separation", "event_summaries", "pairwise_relations", "causal_summary", "duration", "wall_clock", "handoff", "limitations", "report_digest"],
  "properties": {
    "schema": {"const": "in-formation.multi-observer-causal-report/0.1"},
    "path_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "repository": {"const": "Kier73/In-Formation-Space"},
    "run_id": {"type": "string", "minLength": 1},
    "run_attempt": {"type": "string", "minLength": 1},
    "workflow_ref": {"type": "string", "minLength": 1},
    "workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hosts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/producer"}},
    "verifier": {"$ref": "#/$defs/verifier"},
    "host_separation": {
      "type": "object",
      "required": ["distinct_jobs", "distinct_temporal_actors", "all_github_hosted", "producer_host_count", "verifier_is_fourth_job", "artifact_relay", "message_channel_id"],
      "properties": {
        "distinct_jobs": {"const": true},
        "distinct_temporal_actors": {"const": true},
        "all_github_hosted": {"const": true},
        "producer_host_count": {"const": 3},
        "verifier_is_fourth_job": {"const": true},
        "artifact_relay": {"const": "GitHub Actions artifact storage"},
        "message_channel_id": {"const": "github-actions-artifact-relay/v1"}
      },
      "additionalProperties": false
    },
    "event_summaries": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/eventSummary"}},
    "pairwise_relations": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["left_event_id", "right_event_id", "causal_status", "causal_basis", "local_monotonic_status", "wall_status"],
        "properties": {
          "left_event_id": {"enum": ["A1", "A2", "B1", "C1"]},
          "right_event_id": {"enum": ["A1", "A2", "B1", "C1"]},
          "causal_status": {"enum": ["before", "after", "equal", "concurrent", "unobserved"]},
          "causal_basis": {"type": "string", "minLength": 1},
          "local_monotonic_status": {"enum": ["before", "after", "equal", "incomparable"]},
          "wall_status": {"const": "not_used"}
        }
      }
    },
    "causal_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["strict_before_pairs", "concurrent_pairs", "unobserved_pairs", "pair_status_counts", "global_total_order", "interpretation"],
      "properties": {
        "strict_before_pairs": {"type": "array", "items": {"$ref": "#/$defs/directedPair"}},
        "concurrent_pairs": {"type": "array", "items": {"$ref": "#/$defs/undirectedPair"}},
        "unobserved_pairs": {"type": "array", "items": {"$ref": "#/$defs/undirectedPair"}},
        "pair_status_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["before", "after", "equal", "concurrent", "unobserved"],
          "properties": {
            "before": {"type": "integer", "minimum": 0},
            "after": {"type": "integer", "minimum": 0},
            "equal": {"type": "integer", "minimum": 0},
            "concurrent": {"type": "integer", "minimum": 0},
            "unobserved": {"type": "integer", "minimum": 0}
          }
        },
        "global_total_order": {"type": "null"},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "duration": {
      "type": "object", "additionalProperties": false,
      "required": ["local_operation_durations", "combined_cross_host_elapsed_ns", "combined_duration_status", "cpu_time_claimed"],
      "properties": {
        "local_operation_durations": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
        "combined_cross_host_elapsed_ns": {"type": "null"},
        "combined_duration_status": {"const": "not_computed_independent_unaligned_clock_domains"},
        "cpu_time_claimed": {"const": false}
      }
    },
    "wall_clock": {
      "type": "object", "additionalProperties": false,
      "required": ["configured_offsets_ns", "samples", "used_for_causal_order", "interpretation"],
      "properties": {
        "configured_offsets_ns": {"type": "object", "additionalProperties": {"type": "integer"}},
        "samples": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
        "used_for_causal_order": {"const": false},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "predecessor_event_id", "successor_event_id", "message_sequence", "received_sequence", "handoff_digest", "payload_digest", "predecessor_span_digest", "successor_span_digest"],
      "properties": {
        "status": {"const": "verified_from_independently_attested_host_records"},
        "predecessor_event_id": {"const": "A1"},
        "successor_event_id": {"const": "B1"},
        "message_sequence": {"type": "integer", "minimum": 1},
        "received_sequence": {"type": "integer", "minimum": 1},
        "handoff_digest": {"$ref": "#/$defs/digest"},
        "payload_digest": {"$ref": "#/$defs/digest"},
        "predecessor_span_digest": {"$ref": "#/$defs/digest"},
        "successor_span_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "limitations": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}},
    "report_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "job", "actor_id", "runner_name", "runner_os", "runner_arch", "runner_environment", "record_digest", "record_sha256", "attestation"],
      "properties": {
        "role": {"enum": ["source_host", "receiver_host", "observer_host"]},
        "job": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "runner_name": {"type": "string", "minLength": 1},
        "runner_os": {"type": "string", "minLength": 1},
        "runner_arch": {"type": "string", "minLength": 1},
        "runner_environment": {"const": "github-hosted"},
        "record_digest": {"$ref": "#/$defs/digest"},
        "record_sha256": {"$ref": "#/$defs/digest"},
        "attestation": {"$ref": "#/$defs/attestation"}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["verified", "subject_sha256", "predicate_type", "signer_workflow", "source_ref", "self_hosted_runners_denied", "verified_signature_certificate_present", "verified_timestamp_count"],
      "properties": {
        "verified": {"const": true},
        "subject_sha256": {"$ref": "#/$defs/digest"},
        "predicate_type": {"type": "string"},
        "signer_workflow": {"type": "string"},
        "source_ref": {"const": "refs/heads/main"},
        "self_hosted_runners_denied": {"const": true},
        "verified_signature_certificate_present": {"const": true},
        "verified_timestamp_count": {"type": "integer", "minimum": 0}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "job", "actor_id", "runner_name", "runner_os", "runner_arch", "runner_environment"],
      "properties": {
        "role": {"const": "verifier_host"},
        "job": {"const": "verifier_host"},
        "actor_id": {"type": "string", "minLength": 1},
        "runner_name": {"type": "string", "minLength": 1},
        "runner_os": {"type": "string", "minLength": 1},
        "runner_arch": {"type": "string", "minLength": 1},
        "runner_environment": {"const": "github-hosted"}
      }
    },
    "eventSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "role", "actor_id", "clock_segment_id", "causal", "monotonic_elapsed_ns", "wall_utc_ns", "configured_wall_offset_ns", "operation_span_digest", "local_elapsed_ns"],
      "properties": {
        "event_id": {"enum": ["A1", "A2", "B1", "C1"]},
        "role": {"enum": ["source_host", "receiver_host", "observer_host"]},
        "actor_id": {"type": "string", "minLength": 1},
        "clock_segment_id": {"type": "string", "minLength": 1},
        "causal": {"type": ["object", "null"]},
        "monotonic_elapsed_ns": {"type": "integer", "minimum": 0},
        "wall_utc_ns": {"type": "integer"},
        "configured_wall_offset_ns": {"type": "integer"},
        "operation_span_digest": {"$ref": "#/$defs/digest"},
        "local_elapsed_ns": {"type": "integer", "minimum": 0}
      }
    },
    "directedPair": {
      "type": "object", "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"enum": ["A1", "A2", "B1", "C1"]},
        "after": {"enum": ["A1", "A2", "B1", "C1"]}
      }
    },
    "undirectedPair": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {"enum": ["A1", "A2", "B1", "C1"]},
        "right": {"enum": ["A1", "A2", "B1", "C1"]}
      }
    }
  }
}