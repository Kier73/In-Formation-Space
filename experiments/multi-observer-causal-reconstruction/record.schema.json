{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/experiments/multi-observer-causal-reconstruction/record.schema.json",
  "title": "Multi-observer causal reconstruction host record",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema", "role", "host", "wall_offset_ns", "events", "handoff_payload", "handoff_witness", "source_record_sha256", "record_digest"],
  "properties": {
    "format": {"const": "in-formation.multi-observer-causal-record"},
    "schema": {"const": "in-formation.multi-observer-causal-record/0.1"},
    "role": {"enum": ["source_host", "receiver_host", "observer_host"]},
    "host": {"$ref": "#/$defs/host"},
    "wall_offset_ns": {"type": "integer"},
    "events": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/event"}},
    "handoff_payload": {"type": ["object", "null"]},
    "handoff_witness": {"type": ["object", "null"]},
    "source_record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "record_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "source_host"}}, "required": ["role"]},
      "then": {
        "properties": {
          "events": {"minItems": 2, "maxItems": 2},
          "handoff_payload": {"type": "object"},
          "handoff_witness": {"type": "null"},
          "source_record_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "receiver_host"}}, "required": ["role"]},
      "then": {
        "properties": {
          "events": {"minItems": 1, "maxItems": 1},
          "handoff_payload": {"type": "null"},
          "handoff_witness": {"type": "object"},
          "source_record_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "observer_host"}}, "required": ["role"]},
      "then": {
        "properties": {
          "events": {"minItems": 1, "maxItems": 1},
          "handoff_payload": {"type": "null"},
          "handoff_witness": {"type": "null"},
          "source_record_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "repository", "run_id", "run_attempt", "run_number", "workflow_ref", "workflow_sha", "git_ref", "git_sha", "job", "runner_name", "runner_os", "runner_arch", "runner_environment", "actor_id", "clock_segment_id"],
      "properties": {
        "role": {"enum": ["source_host", "receiver_host", "observer_host", "verifier_host"]},
        "repository": {"const": "Kier73/In-Formation-Space"},
        "run_id": {"type": "string", "minLength": 1},
        "run_attempt": {"type": "string", "minLength": 1},
        "run_number": {"type": "string", "minLength": 1},
        "workflow_ref": {"type": "string", "minLength": 1},
        "workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_ref": {"const": "refs/heads/main"},
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "job": {"type": "string", "minLength": 1},
        "runner_name": {"type": "string", "minLength": 1},
        "runner_os": {"type": "string", "minLength": 1},
        "runner_arch": {"type": "string", "minLength": 1},
        "runner_environment": {"const": "github-hosted"},
        "actor_id": {"type": "string", "minLength": 1},
        "clock_segment_id": {"const": "0"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "temporal_frame", "operation_span"],
      "properties": {
        "event_id": {"enum": ["A1", "A2", "B1", "C1"]},
        "temporal_frame": {
          "type": "object",
          "required": ["actor_id", "monotonic", "wall", "causal", "scheduler", "event_lambda", "chronon_phase", "chemical_tau"],
          "properties": {
            "actor_id": {"type": "string", "minLength": 1},
            "monotonic": {
              "type": "object",
              "required": ["actor_id", "segment", "elapsed_ns"],
              "properties": {
                "actor_id": {"type": "string", "minLength": 1},
                "segment": {"type": "integer", "minimum": 0},
                "elapsed_ns": {"type": "integer", "minimum": 0}
              }
            },
            "wall": {
              "type": "object",
              "required": ["actor_id", "utc_ns", "sample_index"],
              "properties": {
                "actor_id": {"type": "string", "minLength": 1},
                "utc_ns": {"type": "integer"},
                "sample_index": {"type": "integer", "minimum": 0}
              }
            },
            "causal": {
              "type": ["object", "null"],
              "required": ["actor_id", "lamport", "vector"],
              "properties": {
                "actor_id": {"type": "string", "minLength": 1},
                "lamport": {"type": "integer", "minimum": 0},
                "vector": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
              }
            },
            "scheduler": {"type": ["object", "null"]},
            "event_lambda": {"type": ["integer", "null"], "minimum": 0},
            "chronon_phase": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
            "chemical_tau": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        },
        "operation_span": {
          "type": "object",
          "required": ["format", "schema", "attempt_id", "span_id", "operation_id", "clock_actor_id", "clock_segment_id", "monotonic_start_ns", "monotonic_end_ns", "elapsed_ns", "clock_status", "outcome", "exception_type", "context", "measurement_scope", "span_digest"],
          "properties": {
            "format": {"const": "in-formation.operation-span"},
            "schema": {"const": "in-formation.operation-span/0.1"},
            "attempt_id": {"type": "string", "minLength": 1},
            "span_id": {"type": "string", "minLength": 1},
            "operation_id": {"type": "string", "minLength": 1},
            "clock_actor_id": {"type": "string", "minLength": 1},
            "clock_segment_id": {"type": "string", "minLength": 1},
            "monotonic_start_ns": {"type": "integer", "minimum": 0},
            "monotonic_end_ns": {"type": "integer", "minimum": 0},
            "elapsed_ns": {"type": "integer", "minimum": 0},
            "clock_status": {"enum": ["measured", "regressed"]},
            "outcome": {"type": "string", "minLength": 1},
            "exception_type": {"type": ["string", "null"]},
            "context": {"type": "object"},
            "measurement_scope": {"type": "string", "minLength": 1},
            "span_digest": {"$ref": "#/$defs/digest"}
          },
          "additionalProperties": true
        }
      }
    }
  }
}