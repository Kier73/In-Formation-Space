{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/experiments/observation-cost-information/run-manifest.schema.json",
  "title": "E-CPU observation cost-information experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema", "experiment_id", "ecpu_reference_commit",
    "python_version", "platform", "clock_actor_id", "clock_segment_id",
    "replicates", "factor_levels", "condition_count", "attempt_count",
    "span_count", "evidence_record_count", "information_outcome_count",
    "profile_matrix_digest", "information_outcome_digests",
    "minimum_profile_samples", "interpretation_limits", "report_digest"
  ],
  "properties": {
    "format": { "const": "in-formation.ecpu-observation-cost-information" },
    "schema": { "const": "in-formation.ecpu-observation-cost-information/0.1" },
    "experiment_id": { "const": "ecpu-observation-cost-information-v1" },
    "ecpu_reference_commit": {
      "const": "800f94f83ffd6f527ed093c8d1c1e93e153c34f6"
    },
    "python_version": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "clock_actor_id": { "type": "string", "minLength": 1 },
    "clock_segment_id": { "type": "string", "minLength": 1 },
    "replicates": { "type": "integer", "minimum": 3 },
    "factor_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_value_bytes", "queue_depth_initial_per_source",
        "source_quorum", "receiver_load_workers"
      ],
      "properties": {
        "payload_value_bytes": {
          "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 4 }
        },
        "queue_depth_initial_per_source": {
          "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }
        },
        "source_quorum": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_count", "quorum"],
            "properties": {
              "source_count": { "type": "integer", "minimum": 1 },
              "quorum": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "receiver_load_workers": {
          "type": "array", "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "condition_count": { "type": "integer", "minimum": 1 },
    "attempt_count": { "type": "integer", "minimum": 1 },
    "span_count": { "type": "integer", "minimum": 1 },
    "evidence_record_count": { "type": "integer", "minimum": 1 },
    "information_outcome_count": { "type": "integer", "minimum": 1 },
    "profile_matrix_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "information_outcome_digests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "minimum_profile_samples": { "type": "integer", "minimum": 1 },
    "interpretation_limits": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "report_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
