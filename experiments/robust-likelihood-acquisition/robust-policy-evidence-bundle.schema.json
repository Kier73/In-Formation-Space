{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/experiments/robust-likelihood-acquisition/robust-policy-evidence-bundle.schema.json",
  "title": "RIV-018 Verified Robust Policy Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema", "policy_execution_record",
    "policy_execution_record_digest", "encounter_envelopes",
    "encounter_envelope_summaries", "authority_ledger",
    "authority_ledger_digest", "authority_receipts",
    "verification_status", "logical_time_contract", "trust_boundary",
    "bundle_digest"
  ],
  "properties": {
    "format": {"const": "in-formation.robust-policy-envelope-authority/0.1"},
    "schema": {"const": "in-formation.robust-policy-envelope-authority/0.1"},
    "policy_execution_record": {"type": "object"},
    "policy_execution_record_digest": {"$ref": "#/$defs/sha256"},
    "encounter_envelopes": {
      "type": "array", "minItems": 1,
      "items": {"type": "object"}
    },
    "encounter_envelope_summaries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id", "encounter_id", "envelope_digest", "payload_digest",
          "integrity_status", "canonicalization", "source_kind",
          "source_reference", "source_evidence_count", "source_ids",
          "logical_event"
        ],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "encounter_id": {"type": "string", "minLength": 1},
          "envelope_digest": {"$ref": "#/$defs/sha256"},
          "payload_digest": {"$ref": "#/$defs/sha256"},
          "integrity_status": {"const": "VERIFIED"},
          "canonicalization": {"const": "json-sort-keys-utf8-v1"},
          "source_kind": {"const": "sensor"},
          "source_reference": {"type": "string", "minLength": 1},
          "source_evidence_count": {"type": "integer", "minimum": 1},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "logical_event": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "logical_time"],
            "properties": {
              "kind": {"const": "robust-policy-observation"},
              "logical_time": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "authority_ledger": {"type": "object"},
    "authority_ledger_digest": {"$ref": "#/$defs/sha256"},
    "authority_receipts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id", "event_key",
          "observation_path_authority_evidence_ref",
          "observation_path_decision_digest",
          "authority_lineage_decision_id",
          "authority_lineage_decision_digest",
          "authority_lineage_evidence_set_digest",
          "authority_lineage_receipt", "verified_envelope_digest"
        ],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "event_key": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "logical_time"],
            "properties": {
              "kind": {"const": "robust-policy-observation"},
              "logical_time": {"type": "integer", "minimum": 0}
            }
          },
          "observation_path_authority_evidence_ref": {"type": "string", "minLength": 1},
          "observation_path_decision_digest": {"$ref": "#/$defs/sha256"},
          "authority_lineage_decision_id": {"type": "string", "minLength": 1},
          "authority_lineage_decision_digest": {"$ref": "#/$defs/sha256"},
          "authority_lineage_evidence_set_digest": {"$ref": "#/$defs/sha256"},
          "authority_lineage_receipt": {"type": "object"},
          "verified_envelope_digest": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "verification_status": {
      "const": "robust_policy_envelopes_verified_and_authority_lineage_reconstructed"
    },
    "logical_time_contract": {"type": "string", "minLength": 1},
    "trust_boundary": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "bundle_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}