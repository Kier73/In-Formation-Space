{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/experiments/reference-calibrated-evidence/signed-reference-evidence-review.schema.json",
  "title": "RIV-014 Signed Reference Evidence Review",
  "type": "object",
  "required": [
    "format", "schema", "verified_reference_evidence_bundle",
    "verified_reference_evidence_bundle_digest", "authority_review_ledger",
    "authority_review_ledger_digest", "review_event_key", "base_content_decision_id",
    "review_proposal_id", "review_policy", "review_certificate", "review_artifacts",
    "signed_review_bundle", "reviewer_trust_store", "root_signed_trust_manifest",
    "root_trust_manifest_digest", "root_trust_registry_id",
    "root_trust_manifest_generation", "root_verification",
    "signed_review_verification", "proposal_resolution",
    "final_authority_decision_id", "final_authority_frontier",
    "review_status", "attestation_scope", "trust_boundary", "review_record_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "in-formation.signed-reference-evidence-review/0.1"},
    "schema": {"const": "in-formation.signed-reference-evidence-review/0.1"},
    "verified_reference_evidence_bundle": {"type": "object"},
    "verified_reference_evidence_bundle_digest": {"$ref": "#/$defs/sha256"},
    "authority_review_ledger": {"type": "object"},
    "authority_review_ledger_digest": {"$ref": "#/$defs/sha256"},
    "review_event_key": {
      "type": "object",
      "required": ["kind", "logical_time"],
      "properties": {
        "kind": {"const": "reference-evidence-bundle-review"},
        "logical_time": {"const": 0}
      },
      "additionalProperties": false
    },
    "base_content_decision_id": {"type": "string", "minLength": 1},
    "review_proposal_id": {"type": "string", "minLength": 1},
    "review_policy": {
      "type": "object",
      "required": ["format", "policy_name", "required_reviewer_seats", "required_votes", "proposer_excluded", "scope", "excludes"],
      "properties": {
        "format": {"const": "in-formation.reference-evidence-review-policy/0.1"},
        "policy_name": {"const": "independent_two_of_two"},
        "required_reviewer_seats": {"const": ["R01", "R02"]},
        "required_votes": {"const": ["APPROVE", "APPROVE"]},
        "proposer_excluded": {"const": true},
        "scope": {"type": "string", "minLength": 1},
        "excludes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "review_certificate": {"type": "object"},
    "review_artifacts": {"type": "object", "additionalProperties": {"type": "string"}},
    "signed_review_bundle": {"type": "object"},
    "reviewer_trust_store": {"type": "object"},
    "root_signed_trust_manifest": {"type": "object"},
    "root_trust_manifest_digest": {"$ref": "#/$defs/sha256"},
    "root_trust_registry_id": {"type": "string", "minLength": 1},
    "root_trust_manifest_generation": {"const": 1},
    "root_verification": {"type": "object"},
    "signed_review_verification": {"type": "object"},
    "proposal_resolution": {
      "type": "object",
      "required": ["proposal_id", "outcome", "signed_review_bundle_digest"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "outcome": {"const": "ACCEPTED"},
        "signed_review_bundle_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "final_authority_decision_id": {"type": "string", "minLength": 1},
    "final_authority_frontier": {"type": "object"},
    "review_status": {"const": "two_independent_signed_approvals_verified"},
    "attestation_scope": {"type": "string", "minLength": 1},
    "trust_boundary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_record_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
