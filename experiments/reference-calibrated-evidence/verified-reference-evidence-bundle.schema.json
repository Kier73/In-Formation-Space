{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/experiments/reference-calibrated-evidence/verified-reference-evidence-bundle.schema.json",
  "title": "RIV-013 Verified Reference Evidence Bundle",
  "type": "object",
  "required": ["format", "schema", "policy_execution_record", "policy_execution_record_digest", "encounter_envelopes", "encounter_envelope_summaries", "authority_ledger", "authority_ledger_digest", "authority_receipts", "verification_status", "trust_boundary", "bundle_digest"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "in-formation.reference-envelope-authority-lineage/0.1"},
    "schema": {"const": "in-formation.reference-envelope-authority-lineage/0.1"},
    "policy_execution_record": {"type": "object"},
    "policy_execution_record_digest": {"$ref": "#/$defs/sha256"},
    "encounter_envelopes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "encounter_envelope_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["encounter_id", "envelope_digest", "payload_digest", "integrity_status", "canonicalization", "source_kind", "source_reference", "source_evidence_count", "source_ids"],
        "properties": {
          "encounter_id": {"type": "string", "minLength": 1},
          "envelope_digest": {"$ref": "#/$defs/sha256"},
          "payload_digest": {"$ref": "#/$defs/sha256"},
          "integrity_status": {"const": "VERIFIED"},
          "canonicalization": {"const": "json-sort-keys-utf8-v1"},
          "source_kind": {"const": "sensor"},
          "source_reference": {"type": "string", "minLength": 1},
          "source_evidence_count": {"type": "integer", "minimum": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "authority_ledger": {"type": "object"},
    "authority_ledger_digest": {"$ref": "#/$defs/sha256"},
    "authority_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attempt_id", "event_key", "observation_path_authority_evidence_ref", "observation_path_decision_digest", "authority_lineage_decision_id", "authority_lineage_decision_digest", "authority_lineage_evidence_set_digest", "authority_lineage_receipt", "verified_envelope_digest"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "event_key": {
            "type": "object",
            "required": ["kind", "logical_time"],
            "properties": {
              "kind": {"const": "reference-calibration"},
              "logical_time": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "observation_path_authority_evidence_ref": {"type": "string", "minLength": 1},
          "observation_path_decision_digest": {"$ref": "#/$defs/sha256"},
          "authority_lineage_decision_id": {"type": "string", "minLength": 1},
          "authority_lineage_decision_digest": {"$ref": "#/$defs/sha256"},
          "authority_lineage_evidence_set_digest": {"$ref": "#/$defs/sha256"},
          "authority_lineage_receipt": {"type": "object"},
          "verified_envelope_digest": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "verification_status": {"const": "inline_envelope_integrity_verified_and_authority_lineage_reconstructed"},
    "trust_boundary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "bundle_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
