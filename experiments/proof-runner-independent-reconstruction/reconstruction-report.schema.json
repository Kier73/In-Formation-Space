{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kier73.github.io/in-formation-space/proof-runner-independent-reconstruction-report/0.2",
  "title": "Independent proof-runner reconstruction report",
  "type": "object",
  "required": [
    "schema",
    "status",
    "route_epoch_id",
    "route_ledger_digest",
    "route_ledger_sequence",
    "authorization_event_digest",
    "execution_id",
    "attempt_id",
    "request_digest",
    "authority",
    "runner",
    "verifier",
    "host_separation",
    "result_digest",
    "return_evidence_digest",
    "proof_trace_digest",
    "completion_receipt_digest",
    "key_provenance_verified_by_github",
    "verified_layers",
    "not_established",
    "sqlite_store_reopened_verified",
    "sqlite_reopen_evidence_digest"
  ],
  "properties": {
    "schema": {
      "const": "in-formation.proof-runner-independent-reconstruction-report/0.2"
    },
    "status": {
      "const": "verified"
    },
    "route_epoch_id": {
      "type": "string",
      "minLength": 1
    },
    "route_ledger_digest": {
      "$ref": "#/$defs/digest"
    },
    "route_ledger_sequence": {
      "type": "integer",
      "minimum": 3
    },
    "authorization_event_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^urn:sha256:[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "authority": {
      "allOf": [
        {
          "$ref": "#/$defs/participant"
        },
        {
          "type": "object",
          "required": [
            "store_type",
            "store_database_sha256",
            "store_revision_count",
            "store_history_digest",
            "process_phase_count",
            "stale_owner_attempt_rejected",
            "owner_generation_after_restart",
            "process_evidence_digest",
            "process_instances",
            "stale_owner_attempt_id",
            "storage_scope",
            "sqlite_reopen_evidence_digest"
          ],
          "properties": {
            "store_type": {
              "const": "sqlite-local-file"
            },
            "store_database_sha256": {
              "$ref": "#/$defs/digest"
            },
            "store_revision_count": {
              "type": "integer",
              "minimum": 4
            },
            "store_history_digest": {
              "$ref": "#/$defs/digest"
            },
            "process_phase_count": {
              "const": 3
            },
            "stale_owner_attempt_rejected": {
              "const": true
            },
            "owner_generation_after_restart": {
              "const": 2
            },
            "process_evidence_digest": {
              "$ref": "#/$defs/digest"
            },
            "process_instances": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "phase",
                  "process_id",
                  "process_instance_id",
                  "decision",
                  "observed_store_revision"
                ],
                "properties": {
                  "phase": {
                    "type": "string",
                    "minLength": 1
                  },
                  "process_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "process_instance_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observed_store_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "stale_owner_attempt_id": {
              "type": "string",
              "minLength": 1
            },
            "storage_scope": {
              "const": "single-host-local-filesystem"
            },
            "sqlite_reopen_evidence_digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "runner": {
      "allOf": [
        {
          "$ref": "#/$defs/participant"
        },
        {
          "type": "object",
          "required": [
            "completion_status"
          ],
          "properties": {
            "completion_status": {
              "const": "result_produced"
            }
          }
        }
      ]
    },
    "verifier": {
      "type": "object",
      "required": [
        "job",
        "actor_id",
        "runner_name"
      ],
      "properties": {
        "job": {
          "const": "independent_verifier_host"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "runner_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "host_separation": {
      "type": "object",
      "required": [
        "distinct_jobs",
        "distinct_actor_ids",
        "all_github_hosted",
        "same_workflow_run",
        "artifact_relay",
        "combined_cross_host_elapsed_ns"
      ],
      "properties": {
        "distinct_jobs": {
          "const": true
        },
        "distinct_actor_ids": {
          "const": true
        },
        "all_github_hosted": {
          "const": true
        },
        "same_workflow_run": {
          "const": true
        },
        "artifact_relay": {
          "const": "GitHub Actions artifact storage"
        },
        "combined_cross_host_elapsed_ns": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "result_digest": {
      "$ref": "#/$defs/digest"
    },
    "return_evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "proof_trace_digest": {
      "$ref": "#/$defs/digest"
    },
    "completion_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "key_provenance_verified_by_github": {
      "type": "boolean"
    },
    "verified_layers": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string"
      }
    },
    "not_established": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "sqlite_store_reopened_verified": {
      "type": "boolean"
    },
    "sqlite_reopen_evidence_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "participant": {
      "type": "object",
      "required": [
        "participant_id",
        "role",
        "key_id",
        "job",
        "actor_id"
      ],
      "properties": {
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "job": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
