{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://in-formation-space.invalid/schemas/ecpu-reliable-observation-recovery-run-manifest-0.1.json",
  "title": "E-CPU reliable observation recovery run manifest",
  "type": "object",
  "required": [
    "format",
    "schema",
    "experiment_id",
    "ecpu_reference_commit",
    "python_version",
    "platform",
    "clock_actor_id",
    "clock_segment_id",
    "replicates_per_condition",
    "factor_levels",
    "condition_count",
    "attempt_count",
    "operation_span_count",
    "application_count",
    "data_retry_attempt_count",
    "ack_retry_attempt_count",
    "duplicate_cleanup_count",
    "all_attempts_authorized",
    "all_applications_exactly_once",
    "all_senders_acknowledged",
    "all_durable_logs_verified",
    "profile_matrix_digest",
    "phase_profile_count",
    "minimum_profile_samples",
    "interpretation_limits",
    "report_digest"
  ],
  "properties": {
    "format": {
      "const": "in-formation.ecpu-reliable-observation-recovery"
    },
    "schema": {
      "const": "in-formation.ecpu-reliable-observation-recovery/0.1"
    },
    "experiment_id": {
      "const": "ecpu-reliable-observation-recovery-v1"
    },
    "ecpu_reference_commit": {
      "const": "800f94f83ffd6f527ed093c8d1c1e93e153c34f6"
    },
    "python_version": {
      "type": "string"
    },
    "platform": {
      "type": "object",
      "required": [
        "system",
        "release",
        "machine",
        "python_implementation"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "python_implementation": {
          "type": "string"
        }
      }
    },
    "clock_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "clock_segment_id": {
      "type": "string",
      "minLength": 1
    },
    "replicates_per_condition": {
      "type": "integer",
      "minimum": 3
    },
    "factor_levels": {
      "type": "object",
      "required": [
        "source_count",
        "quorum",
        "drop_first_data_frame",
        "drop_first_ack"
      ],
      "properties": {
        "source_count": {
          "const": [
            4,
            8
          ]
        },
        "quorum": {
          "const": [
            1,
            2,
            4
          ]
        },
        "drop_first_data_frame": {
          "const": [
            false,
            true
          ]
        },
        "drop_first_ack": {
          "const": [
            false,
            true
          ]
        }
      },
      "additionalProperties": false
    },
    "condition_count": {
      "const": 24
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 72
    },
    "operation_span_count": {
      "type": "integer",
      "minimum": 1
    },
    "application_count": {
      "type": "integer",
      "minimum": 72
    },
    "data_retry_attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "ack_retry_attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_cleanup_count": {
      "type": "integer",
      "minimum": 0
    },
    "all_attempts_authorized": {
      "const": true
    },
    "all_applications_exactly_once": {
      "const": true
    },
    "all_senders_acknowledged": {
      "const": true
    },
    "all_durable_logs_verified": {
      "const": true
    },
    "profile_matrix_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimum_profile_samples": {
      "const": 3
    },
    "interpretation_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "report_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase_profile_count": {
      "type": "integer",
      "minimum": 24
    }
  },
  "additionalProperties": false
}
