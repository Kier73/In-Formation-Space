import COE014SHA256

/-!
COE-014 FIPS 180-4/SHA-256 independently known positive test vectors.
These are runtime vector comparisons of the pure Lean SHA implementation;
they do not establish collision resistance or kernel-prove the entire
cryptographic algorithm equivalent to an external formal SHA specification.
No native_decide is used in the mathematical provenance theorem.
-/
namespace COE014Vectors
open COE014SHA256

def matchesVector (input : List Nat) (expected : List Nat) : Bool :=
  digestHex input == some expected

/-- These checks exercise zero blocks, one-block ASCII, multi-block
binary, padding boundary and the full 64-round compression. -/
def main : IO Unit := do
  let vectors : List (String × List Nat × List Nat) := [
