{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://in-formation-space.invalid/schemas/authority-lineage-ledger-0.1.json",
  "title": "Append-only authority lineage ledger",
  "type": "object",
  "required": [
    "format",
    "schema",
    "ledger_id",
    "entries",
    "ledger_digest"
  ],
  "properties": {
    "format": {
      "const": "in-formation.authority-lineage-ledger"
    },
    "schema": {
      "const": "in-formation.authority-lineage-ledger/0.1"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "entry_type",
          "actor",
          "previous_digest",
          "payload",
          "entry_digest"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "entry_type": {
            "enum": [
              "ledger_created",
              "revision_proposed",
              "proposal_review_certified",
              "proposal_review_signed",
              "proposal_resolved",
              "decision_issued"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "previous_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "entry_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "payload": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "ledger_created"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "ledger_id"
                  ],
                  "properties": {
                    "ledger_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "revision_proposed"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "proposal_id",
                    "event_key",
                    "base_decision_ids",
                    "evidence_refs",
                    "reason",
                    "status_at_creation"
                  ],
                  "properties": {
                    "proposal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_key": {
                      "$ref": "#/$defs/eventKey"
                    },
                    "base_decision_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    },
                    "evidence_refs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "ref",
                          "sha256"
                        ],
                        "properties": {
                          "ref": {
                            "type": "string",
                            "minLength": 1
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status_at_creation": {
                      "const": "PROPOSED"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "proposal_review_certified"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "proposal_id",
                    "event_key",
                    "certificate_id",
                    "certificate_digest",
                    "certificate"
                  ],
                  "properties": {
                    "proposal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_key": {
                      "$ref": "#/$defs/eventKey"
                    },
                    "certificate_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "certificate_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "certificate": {
                      "$ref": "#/$defs/reviewCertificate"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "proposal_review_signed"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "proposal_id",
                    "event_key",
                    "certificate_digest",
                    "bundle_digest",
                    "trust_store_digest",
                    "bundle",
                    "trust_store"
                  ],
                  "properties": {
                    "proposal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_key": {
                      "$ref": "#/$defs/eventKey"
                    },
                    "certificate_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bundle_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "trust_store_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bundle": {
                      "$ref": "#/$defs/signedReviewBundle"
                    },
                    "trust_store": {
                      "$ref": "#/$defs/reviewTrustStore"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "proposal_resolved"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "proposal_id",
                    "outcome",
                    "rationale",
                    "base_decision_ids",
                    "frontier_at_resolution"
                  ],
                  "properties": {
                    "proposal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "outcome": {
                      "enum": [
                        "ACCEPTED",
                        "REJECTED",
                        "INCONCLUSIVE",
                        "STALE"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "base_decision_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    },
                    "frontier_at_resolution": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "review_certificate_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "signed_review_bundle_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "decision_issued"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "decision_id",
                    "event_key",
                    "generation",
                    "supersedes_decision_ids",
                    "proposal_id",
                    "status",
                    "evidence_set_digest",
                    "policy_digest",
                    "representative_ref",
                    "rationale",
                    "issued_by",
                    "decision_digest"
                  ],
                  "properties": {
                    "decision_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_key": {
                      "$ref": "#/$defs/eventKey"
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "supersedes_decision_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    },
                    "proposal_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "enum": [
                        "AUTHORIZED",
                        "CONFLICT",
                        "REFUSED"
                      ]
                    },
                    "evidence_set_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "policy_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "representative_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "issued_by": {
                      "type": "string",
                      "minLength": 1
                    },
                    "decision_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    },
    "ledger_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "eventKey": {
      "type": "object",
      "required": [
        "kind",
        "logical_time"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "logical_time": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "reviewVote": {
      "type": "object",
      "required": [
        "seat",
        "reviewer_ref",
        "vote",
        "rationale",
        "review_ref",
        "review_sha256"
      ],
      "properties": {
        "seat": {
          "enum": [
            "R00",
            "R01",
            "R02"
          ]
        },
        "reviewer_ref": {
          "type": "string",
          "minLength": 1
        },
        "vote": {
          "enum": [
            "APPROVE",
            "REJECT",
            "ABSTAIN"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "reviewCertificate": {
      "type": "object",
      "required": [
        "format",
        "schema",
        "certificate_id",
        "ledger_id",
        "proposal_id",
        "proposal_digest",
        "event_key",
        "base_decision_ids",
        "base_decision_digests",
        "policy_snapshot",
        "policy_digest",
        "reviewer_seats",
        "proposer_seat",
        "evaluator",
        "votes",
        "evaluation",
        "certificate_digest"
      ],
      "properties": {
        "format": {
          "const": "in-formation.authority-review-certificate"
        },
        "schema": {
          "const": "in-formation.authority-review-certificate/0.1"
        },
        "certificate_id": {
          "type": "string",
          "minLength": 1
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event_key": {
          "$ref": "#/$defs/eventKey"
        },
        "base_decision_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "base_decision_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "policy_snapshot": {
          "type": "object",
          "required": [
            "policy_id",
            "definition",
            "reviewer_seats",
            "proposer_seat",
            "evaluator"
          ],
          "properties": {
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "definition": {
              "type": "object",
              "required": [
                "include_proposer",
                "minimum_distinct_reviewers",
                "approvals_required",
                "rejections_required",
                "description"
              ],
              "properties": {
                "include_proposer": {
                  "type": "boolean"
                },
                "minimum_distinct_reviewers": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "approvals_required": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "rejections_required": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "reviewer_seats": {
              "type": "array",
              "const": [
                "R00",
                "R01",
                "R02"
              ]
            },
            "proposer_seat": {
              "const": "R00"
            },
            "evaluator": {
              "const": "in-formation.authority-review-evaluator/0.1"
            }
          },
          "additionalProperties": false
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_seats": {
          "type": "array",
          "const": [
            "R00",
            "R01",
            "R02"
          ]
        },
        "proposer_seat": {
          "const": "R00"
        },
        "evaluator": {
          "const": "in-formation.authority-review-evaluator/0.1"
        },
        "votes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewVote"
          }
        },
        "evaluation": {
          "type": "object",
          "required": [
            "outcome",
            "reason",
            "eligible_reviewers",
            "present_eligible_reviewers",
            "approval_count",
            "rejection_count",
            "abstention_count",
            "proposer_vote_counted",
            "conflicting_thresholds",
            "seat_pattern"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "ACCEPTED",
                "REJECTED",
                "INCONCLUSIVE"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "eligible_reviewers": {
              "type": "array",
              "items": {
                "enum": [
                  "R00",
                  "R01",
                  "R02"
                ]
              }
            },
            "present_eligible_reviewers": {
              "type": "array",
              "items": {
                "enum": [
                  "R00",
                  "R01",
                  "R02"
                ]
              }
            },
            "approval_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "rejection_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "abstention_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "proposer_vote_counted": {
              "type": "boolean"
            },
            "conflicting_thresholds": {
              "type": "boolean"
            },
            "seat_pattern": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "enum": [
                  "ABSENT",
                  "APPROVE",
                  "REJECT",
                  "ABSTAIN"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "certificate_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "signedReviewBundle": {
      "type": "object",
      "required": [
        "format",
        "schema",
        "signature_profile",
        "certificate_digest",
        "payload_type",
        "trust_store_digest",
        "review_artifacts_verified",
        "signed_review_votes",
        "bundle_digest"
      ],
      "properties": {
        "format": {
          "const": "in-formation.signed-review-bundle"
        },
        "schema": {
          "const": "in-formation.signed-review-bundle/0.1"
        },
        "signature_profile": {
          "const": "DSSEv1+Ed25519"
        },
        "certificate_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload_type": {
          "const": "application/vnd.in-formation.authority-review-vote+json;version=0.2"
        },
        "trust_store_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_artifacts_verified": {
          "type": "boolean"
        },
        "signed_review_votes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "seat",
              "reviewer_ref",
              "keyid",
              "envelope"
            ],
            "properties": {
              "seat": {
                "enum": [
                  "R00",
                  "R01",
                  "R02"
                ]
              },
              "reviewer_ref": {
                "type": "string",
                "minLength": 1
              },
              "keyid": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "envelope": {
                "type": "object",
                "required": [
                  "payloadType",
                  "payload",
                  "signatures"
                ],
                "properties": {
                  "payloadType": {
                    "const": "application/vnd.in-formation.authority-review-vote+json;version=0.2"
                  },
                  "payload": {
                    "type": "string",
                    "minLength": 1,
                    "contentEncoding": "base64"
                  },
                  "signatures": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "keyid",
                        "sig"
                      ],
                      "properties": {
                        "keyid": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "sig": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9+/]{86}==$",
                          "contentEncoding": "base64"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "reviewTrustStore": {
      "type": "object",
      "required": [
        "format",
        "schema",
        "keys"
      ],
      "properties": {
        "format": {
          "const": "in-formation.review-trust-store"
        },
        "schema": {
          "const": "in-formation.review-trust-store/0.1"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "keyid",
              "principal",
              "seat",
              "public_key"
            ],
            "properties": {
              "keyid": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "principal": {
                "type": "string",
                "minLength": 1
              },
              "seat": {
                "enum": [
                  "R00",
                  "R01",
                  "R02"
                ]
              },
              "public_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{43}=$",
                "contentEncoding": "base64"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
