{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://in-formation-space.invalid/schemas/authority-lineage-ledger-0.1.json",
  "title": "Append-only authority lineage ledger",
  "type": "object",
  "required": [
    "format",
    "schema",
    "ledger_id",
    "entries",
    "ledger_digest"
  ],
  "properties": {
    "format": {
      "const": "in-formation.authority-lineage-ledger"
    },
    "schema": {
      "const": "in-formation.authority-lineage-ledger/0.1"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "entry_type",
          "actor",
          "previous_digest",
          "payload",
          "entry_digest"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "entry_type": {
            "enum": [
              "ledger_created",
              "revision_proposed",
              "proposal_resolved",
              "decision_issued"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "previous_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "entry_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "payload": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "ledger_created"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "ledger_id"
                  ],
                  "properties": {
                    "ledger_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "revision_proposed"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "proposal_id",
                    "event_key",
                    "base_decision_ids",
                    "evidence_refs",
                    "reason",
                    "status_at_creation"
                  ],
                  "properties": {
                    "proposal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_key": {
                      "$ref": "#/$defs/eventKey"
                    },
                    "base_decision_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    },
                    "evidence_refs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "ref",
                          "sha256"
                        ],
                        "properties": {
                          "ref": {
                            "type": "string",
                            "minLength": 1
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status_at_creation": {
                      "const": "PROPOSED"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "proposal_resolved"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "proposal_id",
                    "outcome",
                    "rationale",
                    "base_decision_ids",
                    "frontier_at_resolution"
                  ],
                  "properties": {
                    "proposal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "outcome": {
                      "enum": [
                        "ACCEPTED",
                        "REJECTED",
                        "INCONCLUSIVE",
                        "STALE"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "base_decision_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    },
                    "frontier_at_resolution": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entry_type": {
                  "const": "decision_issued"
                }
              },
              "required": [
                "entry_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "decision_id",
                    "event_key",
                    "generation",
                    "supersedes_decision_ids",
                    "proposal_id",
                    "status",
                    "evidence_set_digest",
                    "policy_digest",
                    "representative_ref",
                    "rationale",
                    "issued_by",
                    "decision_digest"
                  ],
                  "properties": {
                    "decision_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_key": {
                      "$ref": "#/$defs/eventKey"
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "supersedes_decision_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    },
                    "proposal_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "enum": [
                        "AUTHORIZED",
                        "CONFLICT",
                        "REFUSED"
                      ]
                    },
                    "evidence_set_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "policy_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "representative_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "issued_by": {
                      "type": "string",
                      "minLength": 1
                    },
                    "decision_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    },
    "ledger_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "eventKey": {
      "type": "object",
      "required": [
        "kind",
        "logical_time"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "logical_time": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
