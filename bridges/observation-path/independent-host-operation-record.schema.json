{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/independent-host-operation-record.schema.json",
  "title": "Independent hosted-host operation record",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema", "role", "host", "operation_span", "temporal_frame", "handoff_payload", "source_record_sha256", "handoff_witness", "record_digest"],
  "properties": {
    "format": {"const": "in-formation.independent-host-operation-record"},
    "schema": {"const": "in-formation.independent-host-operation-record/0.1"},
    "role": {"enum": ["source_host", "receiver_host"]},
    "host": {"$ref": "#/$defs/host"},
    "operation_span": {"$ref": "operation-span.schema.json"},
    "temporal_frame": {"$ref": "#/$defs/temporalFrame"},
    "handoff_payload": {"anyOf": [{"$ref": "#/$defs/handoffPayload"}, {"type": "null"}]},
    "source_record_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "handoff_witness": {"anyOf": [{"$ref": "#/$defs/handoffWitness"}, {"type": "null"}]},
    "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "oneOf": [
    {"properties": {"role": {"const": "source_host"}, "handoff_payload": {"$ref": "#/$defs/handoffPayload"}, "source_record_sha256": {"type": "null"}, "handoff_witness": {"type": "null"}}},
    {"properties": {"role": {"const": "receiver_host"}, "handoff_payload": {"type": "null"}, "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "handoff_witness": {"$ref": "#/$defs/handoffWitness"}}}
  ],
  "$defs": {
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "repository", "run_id", "run_attempt", "run_number", "workflow_ref", "workflow_sha", "git_ref", "git_sha", "job", "runner_name", "runner_os", "runner_arch", "runner_environment", "actor_id", "clock_segment_id"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "run_attempt": {"type": "string", "minLength": 1},
        "run_number": {"type": "string", "minLength": 1},
        "workflow_ref": {"type": "string", "minLength": 1},
        "workflow_sha": {"type": "string", "minLength": 1},
        "git_ref": {"type": "string", "minLength": 1},
        "git_sha": {"type": "string", "minLength": 1},
        "job": {"type": "string", "minLength": 1},
        "runner_name": {"type": "string", "minLength": 1},
        "runner_os": {"type": "string", "minLength": 1},
        "runner_arch": {"type": "string", "minLength": 1},
        "runner_environment": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "clock_segment_id": {"type": "string", "minLength": 1}
      }
    },
    "temporalFrame": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "monotonic", "wall", "causal", "scheduler", "event_lambda", "chronon_phase", "chemical_tau"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "monotonic": {"anyOf": [{"type": "object", "additionalProperties": false, "required": ["actor_id", "segment", "elapsed_ns"], "properties": {"actor_id": {"type": "string"}, "segment": {"type": "integer", "minimum": 0}, "elapsed_ns": {"type": "integer", "minimum": 0}}}, {"type": "null"}]},
        "wall": {"type": ["object", "null"]},
        "causal": {"anyOf": [{"type": "object", "additionalProperties": false, "required": ["actor_id", "lamport", "vector"], "properties": {"actor_id": {"type": "string"}, "lamport": {"type": "integer", "minimum": 0}, "vector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}}}}, {"type": "null"}]},
        "scheduler": {"type": ["object", "null"]},
        "event_lambda": {"type": ["integer", "null"], "minimum": 0},
        "chronon_phase": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "chemical_tau": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "handoffPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "path_id", "attempt_id", "predecessor_span_digest", "sender_actor_id", "sender_completion_frame", "payload_digest"],
      "properties": {
        "schema": {"const": "in-formation.operation-path.handoff-payload/0.1"},
        "path_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "predecessor_span_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sender_actor_id": {"type": "string", "minLength": 1},
        "sender_completion_frame": {"$ref": "#/$defs/temporalFrame"},
        "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "handoffWitness": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "path_id", "attempt_id", "predecessor_span_digest", "successor_span_digest", "channel_id", "message_sequence", "received_sequence", "sender_actor_id", "receiver_actor_id", "payload_digest", "sender_completion_frame", "receiver_start_frame", "handoff_digest"],
      "properties": {
        "schema": {"const": "in-formation.operation-path.causal-handoff/0.1"},
        "path_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "predecessor_span_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "successor_span_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "channel_id": {"type": "string", "minLength": 1},
        "message_sequence": {"type": "integer", "minimum": 1},
        "received_sequence": {"type": "integer", "minimum": 1},
        "sender_actor_id": {"type": "string", "minLength": 1},
        "receiver_actor_id": {"type": "string", "minLength": 1},
        "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sender_completion_frame": {"$ref": "#/$defs/temporalFrame"},
        "receiver_start_frame": {"$ref": "#/$defs/temporalFrame"},
        "handoff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
