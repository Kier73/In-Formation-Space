{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/temporal-path-binding.schema.json",
  "title": "In-Formation-Space Observation/Temporal Trace Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_id",
    "observation_path_digest",
    "temporal_trace_ref",
    "temporal_trace_digest",
    "event_bindings",
    "intervals",
    "binding_digest"
  ],
  "properties": {
    "schema": {
      "const": "in-formation.observation-temporal-binding/0.1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_path_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "temporal_trace_ref": {
      "type": "string",
      "minLength": 1
    },
    "temporal_trace_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "stage",
          "observation_event_digest",
          "temporal_frame_actor_id",
          "temporal_frame_digest"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "observation_event_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "temporal_frame_actor_id": {
            "type": "string",
            "minLength": 1
          },
          "temporal_frame_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_stage",
          "to_stage",
          "delta"
        ],
        "properties": {
          "from_stage": {
            "type": "string",
            "minLength": 1
          },
          "to_stage": {
            "type": "string",
            "minLength": 1
          },
          "delta": {
            "type": "object"
          }
        }
      }
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
