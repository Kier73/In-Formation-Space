{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/direct-mtls-host-record.schema.json",
  "title": "Direct mTLS host operation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role",
    "status",
    "host",
    "certificate_sha256",
    "operation_span",
    "temporal_frame",
    "endpoint_digest",
    "handoff_envelope",
    "received_envelope",
    "receiver_receipt",
    "peer_certificate_sha256",
    "error",
    "record_digest"
  ],
  "properties": {
    "schema": {
      "const": "in-formation.direct-mtls-host-record/0.1"
    },
    "role": {
      "enum": [
        "client_host",
        "server_host"
      ]
    },
    "status": {
      "enum": [
        "direct_mtls_verified",
        "direct_tcp_unavailable",
        "direct_mtls_rejected"
      ]
    },
    "host": {
      "type": "object"
    },
    "certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation_span": {
      "anyOf": [
        {
          "$ref": "#/$defs/operationSpan"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporal_frame": {
      "type": [
        "object",
        "null"
      ]
    },
    "endpoint_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "handoff_envelope": {
      "type": [
        "object",
        "null"
      ]
    },
    "received_envelope": {
      "type": [
        "object",
        "null"
      ]
    },
    "receiver_receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "peer_certificate_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "direct_mtls_verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "operation_span": {
            "$ref": "#/$defs/operationSpan"
          },
          "temporal_frame": {
            "type": "object"
          },
          "peer_certificate_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "operationSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema",
        "attempt_id",
        "span_id",
        "operation_id",
        "clock_actor_id",
        "clock_segment_id",
        "monotonic_start_ns",
        "monotonic_end_ns",
        "elapsed_ns",
        "clock_status",
        "outcome",
        "exception_type",
        "context",
        "measurement_scope",
        "span_digest"
      ],
      "properties": {
        "format": {
          "const": "in-formation.operation-span"
        },
        "schema": {
          "const": "in-formation.operation-span/0.1"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "span_id": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_actor_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_segment_id": {
          "type": "string",
          "minLength": 1
        },
        "monotonic_start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "monotonic_end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ns": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "clock_status": {
          "enum": [
            "measured",
            "regressed"
          ]
        },
        "outcome": {
          "enum": [
            "succeeded",
            "raised"
          ]
        },
        "exception_type": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "peer_route_observation": {
              "$ref": "#/$defs/peerRouteObservation"
            }
          },
          "additionalProperties": true
        },
        "measurement_scope": {
          "type": "string",
          "minLength": 1
        },
        "span_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "clock_status": {
                "const": "measured"
              }
            },
            "required": [
              "clock_status"
            ]
          },
          "then": {
            "properties": {
              "monotonic_end_ns": {
                "minimum": 0
              },
              "elapsed_ns": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "clock_status": {
                "const": "regressed"
              }
            },
            "required": [
              "clock_status"
            ]
          },
          "then": {
            "properties": {
              "elapsed_ns": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "succeeded"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "exception_type": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "raised"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "exception_type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "peerRouteObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "observer_role",
        "local_overlay_ipv4",
        "peer_overlay_ipv4",
        "route_state",
        "route_type",
        "command",
        "exit_code",
        "observed_monotonic_ns",
        "elapsed_ns",
        "matched_peer_status",
        "status_output_sha256",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "in-formation.ihp006-peer-route-observation/0.1"
        },
        "observer_role": {
          "enum": [
            "client_host",
            "server_host"
          ]
        },
        "local_overlay_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "peer_overlay_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "route_state": {
          "enum": [
            "active",
            "idle",
            "no_session",
            "peer_not_found",
            "command_failed"
          ]
        },
        "route_type": {
          "enum": [
            "direct",
            "derp_relay",
            "peer_relay",
            "reachable_unclassified"
          ]
        },
        "command": {
          "const": "tailscale status"
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "matched_peer_status": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 64
            }
          ]
        },
        "status_output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 160
            }
          ]
        },
        "observed_monotonic_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
