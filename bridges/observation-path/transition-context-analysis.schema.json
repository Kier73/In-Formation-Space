{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/transition-context-analysis.schema.json",
  "title": "Context-stratified Trial 08 Transition Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema",
    "model_ref",
    "model_digest",
    "source_conformance_digests",
    "source_conformance_records",
    "source_context_assignment_digests",
    "source_context_assignments",
    "cells",
    "pairwise_semantics",
    "frequency_semantics",
    "policy_effect",
    "model_effect",
    "interpretation_limits",
    "analysis_digest"
  ],
  "properties": {
    "format": {"const": "in-formation.transition-context-analysis"},
    "schema": {"const": "in-formation.transition-context-analysis/0.1"},
    "model_ref": {"type": "string", "minLength": 1},
    "model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_conformance_digests": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "source_conformance_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "schema", "attempt_id", "conformance_digest"],
        "properties": {
          "format": {"const": "in-formation.transition-conformance"},
          "schema": {"const": "in-formation.transition-conformance/0.1"},
          "attempt_id": {"type": "string", "minLength": 1},
          "conformance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "source_context_assignment_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "source_context_assignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/contextAssignment"}
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "current_state",
          "sample_count",
          "full_transition_sample_count",
          "outcome_only_sample_count",
          "context_assignment_count",
          "unassigned_attempt_ids",
          "dimensions",
          "joint_context"
        ],
        "properties": {
          "probe_id": {"type": "string", "minLength": 1},
          "current_state": {"type": "string", "minLength": 1},
          "sample_count": {"type": "integer", "minimum": 1},
          "full_transition_sample_count": {"type": "integer", "minimum": 0},
          "outcome_only_sample_count": {"type": "integer", "minimum": 0},
          "context_assignment_count": {"type": "integer", "minimum": 0},
          "unassigned_attempt_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "dimensions": {
            "type": "array",
            "items": {"$ref": "#/$defs/dimensionAnalysis"}
          },
          "joint_context": {
            "anyOf": [
              {"type": "null"},
              {"$ref": "#/$defs/jointAnalysis"}
            ]
          }
        }
      }
    },
    "pairwise_semantics": {
      "const": "exact_descriptive_disagreement_counts_over_observed_full_transition_pairs"
    },
    "frequency_semantics": {
      "const": "descriptive_empirical_sample_fraction_not_transition_probability"
    },
    "policy_effect": {"const": "none"},
    "model_effect": {"const": "none"},
    "interpretation_limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "analysis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "fraction": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 0},
            "denominator": {"type": "integer", "minimum": 1}
          }
        },
        {"type": "null"}
      ]
    },
    "contextAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema",
        "attempt_id",
        "conformance_digest",
        "dimensions",
        "assignment_digest"
      ],
      "properties": {
        "format": {"const": "in-formation.transition-context-assignment"},
        "schema": {"const": "in-formation.transition-context-assignment/0.1"},
        "attempt_id": {"type": "string", "minLength": 1},
        "conformance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "value"],
                "properties": {
                  "status": {"const": "observed"},
                  "value": {
                    "anyOf": [
                      {"type": "string"},
                      {"type": "integer"},
                      {"type": "boolean"},
                      {"type": "null"}
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "reason"],
                "properties": {
                  "status": {"const": "unknown"},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        },
        "source_ref": {"type": "string", "minLength": 1},
        "assignment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "histogram": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["count", "empirical_frequency", "source_attempt_ids"],
        "properties": {
          "count": {"type": "integer", "minimum": 1},
          "empirical_frequency": {"$ref": "#/$defs/fraction"},
          "source_attempt_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "outcome": {},
          "next_state": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "contextGroup": {
      "type": "object",
      "required": [
        "value",
        "sample_count",
        "full_transition_sample_count",
        "outcome_only_sample_count",
        "full_transition_histogram",
        "outcome_only_histogram",
        "source_attempt_ids"
      ],
      "properties": {
        "value": {},
        "sample_count": {"type": "integer", "minimum": 1},
        "full_transition_sample_count": {"type": "integer", "minimum": 0},
        "outcome_only_sample_count": {"type": "integer", "minimum": 0},
        "full_transition_histogram": {"$ref": "#/$defs/histogram"},
        "outcome_only_histogram": {"$ref": "#/$defs/histogram"},
        "source_attempt_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "pairwiseComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_transition_sample_count",
        "pooled_pair_count",
        "pooled_disagreement_pair_count",
        "pooled_disagreement_fraction",
        "within_stratum_pair_count",
        "within_stratum_disagreement_pair_count",
        "within_stratum_disagreement_fraction",
        "between_stratum_pair_count",
        "between_stratum_disagreement_pair_count",
        "between_stratum_disagreement_fraction",
        "separation_status"
      ],
      "properties": {
        "full_transition_sample_count": {"type": "integer", "minimum": 0},
        "pooled_pair_count": {"type": "integer", "minimum": 0},
        "pooled_disagreement_pair_count": {"type": "integer", "minimum": 0},
        "pooled_disagreement_fraction": {"$ref": "#/$defs/fraction"},
        "within_stratum_pair_count": {"type": "integer", "minimum": 0},
        "within_stratum_disagreement_pair_count": {"type": "integer", "minimum": 0},
        "within_stratum_disagreement_fraction": {"$ref": "#/$defs/fraction"},
        "between_stratum_pair_count": {"type": "integer", "minimum": 0},
        "between_stratum_disagreement_pair_count": {"type": "integer", "minimum": 0},
        "between_stratum_disagreement_fraction": {"$ref": "#/$defs/fraction"},
        "separation_status": {
          "enum": [
            "no_full_transition_witnesses",
            "insufficient_distinct_observed_context_values",
            "no_pooled_transition_diversity",
            "no_within_stratum_pairs_to_test",
            "observed_partition_separates_supplied_sample",
            "observed_partition_reduces_within_stratum_disagreement",
            "no_observed_within_stratum_disagreement_reduction"
          ]
        }
      }
    },
    "dimensionAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "assigned_attempt_count",
        "observed_attempt_count",
        "unknown_attempt_ids",
        "not_supplied_attempt_ids",
        "unassigned_attempt_ids",
        "distinct_observed_value_count",
        "groups",
        "pairwise_comparison"
      ],
      "properties": {
        "dimension": {"type": "string", "minLength": 1},
        "assigned_attempt_count": {"type": "integer", "minimum": 0},
        "observed_attempt_count": {"type": "integer", "minimum": 0},
        "unknown_attempt_ids": {"type": "array", "items": {"type": "string"}},
        "not_supplied_attempt_ids": {"type": "array", "items": {"type": "string"}},
        "unassigned_attempt_ids": {"type": "array", "items": {"type": "string"}},
        "distinct_observed_value_count": {"type": "integer", "minimum": 0},
        "groups": {"type": "array", "items": {"$ref": "#/$defs/contextGroup"}},
        "pairwise_comparison": {"$ref": "#/$defs/pairwiseComparison"}
      }
    },
    "jointAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_names",
        "complete_context_attempt_ids",
        "incomplete_context_attempt_ids",
        "distinct_joint_context_count",
        "groups",
        "pairwise_comparison"
      ],
      "properties": {
        "dimension_names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "complete_context_attempt_ids": {"type": "array", "items": {"type": "string"}},
        "incomplete_context_attempt_ids": {"type": "array", "items": {"type": "string"}},
        "distinct_joint_context_count": {"type": "integer", "minimum": 0},
        "groups": {"type": "array", "items": {"$ref": "#/$defs/contextGroup"}},
        "pairwise_comparison": {"$ref": "#/$defs/pairwiseComparison"}
      }
    }
  }
}
