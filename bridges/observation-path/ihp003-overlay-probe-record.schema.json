{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/ihp003-overlay-probe-record.schema.json",
  "title":"IHP-003 independent Tailscale route probe record",
  "type":"object","additionalProperties":false,
  "required":["schema","role","host","status","overlay_provider","overlay_tag","overlay_ipv4","address_digest","peer_address_digest","peer_role","peer_overlay_ipv4","peer_address_attestation","route_type","ping_count","ping_exit_code","ping_output","diagnostic","record_digest"],
  "properties":{
    "schema":{"const":"in-formation.ihp003-overlay-probe-record/0.1"},
    "role":{"enum":["client_host","server_host"]},"host":{"type":"object"},
    "status":{"enum":["route_observed","route_unavailable","credentials_missing","peer_overlay_not_configured"]},
    "overlay_provider":{"const":"tailscale"},"overlay_tag":{"const":"tag:ihp003-ci"},
    "overlay_ipv4":{"type":["string","null"],"format":"ipv4"},
    "address_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "peer_address_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "peer_role":{"enum":["client_host","server_host"]},
    "peer_overlay_ipv4":{"type":["string","null"],"format":"ipv4"},
    "peer_address_attestation":{"type":["object","null"]},
    "route_type":{"enum":["direct","derp_relay","peer_relay","reachable_unclassified","unreachable","not_attempted"]},
    "ping_count":{"type":"integer","minimum":0},
    "ping_exit_code":{"type":["integer","null"]},
    "ping_output":{"type":"string"},"diagnostic":{"type":"string","minLength":1},
    "record_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"route_observed"}},"required":["status"]},"then":{"properties":{"route_type":{"enum":["direct","derp_relay","peer_relay","reachable_unclassified"]},"ping_count":{"minimum":1},"ping_exit_code":{"const":0},"peer_address_digest":{"type":"string"},"overlay_ipv4":{"type":"string","format":"ipv4"},"peer_overlay_ipv4":{"type":"string","format":"ipv4"}}}},
    {"if":{"properties":{"status":{"const":"route_unavailable"}},"required":["status"]},"then":{"properties":{"route_type":{"const":"unreachable"},"ping_count":{"minimum":1},"peer_address_digest":{"type":"string"}}}},
    {"if":{"properties":{"status":{"enum":["credentials_missing","peer_overlay_not_configured"]}},"required":["status"]},"then":{"properties":{"route_type":{"const":"not_attempted"},"ping_count":{"const":0},"ping_exit_code":{"type":"null"}}}}
  ]
}
