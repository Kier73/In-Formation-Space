{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/ihp003-overlay-probe-record-predicate.schema.json",
  "title":"IHP-003 probe record attestation predicate",
  "type":"object","additionalProperties":false,
  "required":["schema","role","host","record_sha256","record_digest","status","route_type"],
  "properties":{
    "schema":{"const":"in-formation.ihp003-overlay-probe-record-predicate/0.1"},
    "role":{"enum":["client_host","server_host"]},"host":{"type":"object"},
    "record_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "record_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status":{"enum":["route_observed","route_unavailable","credentials_missing","peer_overlay_not_configured"]},
    "route_type":{"enum":["direct","derp_relay","peer_relay","reachable_unclassified","unreachable","not_attempted"]}
  }
}
