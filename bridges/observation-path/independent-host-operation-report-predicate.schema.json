{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/independent-host-operation-report-predicate.schema.json",
  "title": "Independent hosted-host report attestation predicate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "repository", "run_id", "run_attempt", "workflow_ref",
    "workflow_sha", "git_ref", "git_sha", "job", "runner_name",
    "runner_os", "runner_arch", "runner_environment", "actor_id",
    "report_sha256", "report_digest", "source_record_sha256",
    "receiver_record_sha256", "path_id", "causal_handoff_digest"
  ],
  "properties": {
    "schema": {"const": "in-formation.independent-host-report-predicate/0.1"},
    "repository": {"const": "Kier73/In-Formation-Space"},
    "run_id": {"type": "string", "minLength": 1},
    "run_attempt": {"type": "string", "minLength": 1},
    "workflow_ref": {"type": "string", "minLength": 1},
    "workflow_sha": {"type": "string", "minLength": 1},
    "git_ref": {"const": "refs/heads/main"},
    "git_sha": {"type": "string", "minLength": 1},
    "job": {"const": "verifier_host"},
    "runner_name": {"type": "string", "minLength": 1},
    "runner_os": {"type": "string", "minLength": 1},
    "runner_arch": {"type": "string", "minLength": 1},
    "runner_environment": {"const": "github-hosted"},
    "actor_id": {"type": "string", "minLength": 1},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receiver_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_id": {"type": "string", "minLength": 1},
    "causal_handoff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
