{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/cross-language-host-operation-report.schema.json",
  "title": "Cross-language hosted operation-path reconstruction report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "path_id",
    "attempt_id",
    "repository",
    "run_id",
    "run_attempt",
    "workflow_ref",
    "workflow_sha",
    "source",
    "receiver",
    "cross_language_verifier",
    "checks",
    "causal_reconstruction",
    "duration",
    "scope",
    "report_digest"
  ],
  "properties": {
    "schema": {
      "const": "in-formation.cross-language-host-operation-report/0.1"
    },
    "path_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "const": "Kier73/In-Formation-Space"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_attempt": {
      "type": "string",
      "minLength": 1
    },
    "workflow_ref": {
      "type": "string",
      "minLength": 1
    },
    "workflow_sha": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/hostReport"
    },
    "receiver": {
      "allOf": [
        {
          "$ref": "#/$defs/hostReport"
        },
        {
          "type": "object",
          "required": [
            "source_artifact_sha256"
          ],
          "properties": {
            "source_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "cross_language_verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "job",
        "actor_id",
        "runner_name",
        "runner_os",
        "runner_arch",
        "runner_environment"
      ],
      "properties": {
        "role": {
          "const": "cross_language_verifier_host"
        },
        "job": {
          "const": "cross_language_verifier_host"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "runner_name": {
          "type": "string",
          "minLength": 1
        },
        "runner_os": {
          "type": "string",
          "minLength": 1
        },
        "runner_arch": {
          "type": "string",
          "minLength": 1
        },
        "runner_environment": {
          "const": "github-hosted"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source_bytes",
        "canonical_receiver_bytes",
        "source_record_digest",
        "receiver_record_digest",
        "source_artifact_bytes_bound_by_receiver",
        "both_operation_span_digests",
        "host_actor_and_clock_segment_bindings",
        "sender_payload_digest_reconstructed",
        "receiver_handoff_digest_reconstructed",
        "handoff_endpoint_digests_and_attempt",
        "sender_and_receiver_frame_bindings",
        "local_monotonic_endpoint_constraints",
        "strict_vector_clock_happens_before",
        "artifact_relay_sequence_matches"
      ],
      "properties": {
        "canonical_source_bytes": {
          "const": true
        },
        "canonical_receiver_bytes": {
          "const": true
        },
        "source_record_digest": {
          "const": true
        },
        "receiver_record_digest": {
          "const": true
        },
        "source_artifact_bytes_bound_by_receiver": {
          "const": true
        },
        "both_operation_span_digests": {
          "const": true
        },
        "host_actor_and_clock_segment_bindings": {
          "const": true
        },
        "sender_payload_digest_reconstructed": {
          "const": true
        },
        "receiver_handoff_digest_reconstructed": {
          "const": true
        },
        "handoff_endpoint_digests_and_attempt": {
          "const": true
        },
        "sender_and_receiver_frame_bindings": {
          "const": true
        },
        "local_monotonic_endpoint_constraints": {
          "const": true
        },
        "strict_vector_clock_happens_before": {
          "const": true
        },
        "artifact_relay_sequence_matches": {
          "const": true
        }
      }
    },
    "causal_reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "edge_count",
        "edge_basis",
        "relay_channel_id",
        "message_sequence",
        "received_sequence",
        "vector_relation",
        "sender_vector",
        "receiver_vector",
        "sender_lamport",
        "receiver_lamport",
        "predecessor_span_digest",
        "successor_span_digest",
        "payload_digest",
        "handoff_digest",
        "topological_order"
      ],
      "properties": {
        "status": {
          "const": "reconstructed_from_independent_go_implementation"
        },
        "edge_count": {
          "const": 1
        },
        "edge_basis": {
          "type": "string",
          "minLength": 1
        },
        "relay_channel_id": {
          "const": "github-actions-artifact-relay/v1"
        },
        "message_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "received_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "vector_relation": {
          "const": "before"
        },
        "sender_vector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "receiver_vector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sender_lamport": {
          "type": "integer",
          "minimum": 0
        },
        "receiver_lamport": {
          "type": "integer",
          "minimum": 0
        },
        "predecessor_span_digest": {
          "$ref": "#/$defs/sha256"
        },
        "successor_span_digest": {
          "$ref": "#/$defs/sha256"
        },
        "payload_digest": {
          "$ref": "#/$defs/sha256"
        },
        "handoff_digest": {
          "$ref": "#/$defs/sha256"
        },
        "topological_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_local_elapsed_ns",
        "receiver_local_elapsed_ns",
        "combined_cross_host_elapsed_ns",
        "status"
      ],
      "properties": {
        "source_local_elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "receiver_local_elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "combined_cross_host_elapsed_ns": {
          "type": "null"
        },
        "status": {
          "const": "not_computed_independent_unaligned_clock_domains"
        }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "report_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hostReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "actor_id",
        "runner_name",
        "runner_os",
        "runner_arch",
        "local_elapsed_ns",
        "span_digest",
        "record_digest",
        "artifact_sha256"
      ],
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "runner_name": {
          "type": "string",
          "minLength": 1
        },
        "runner_os": {
          "type": "string",
          "minLength": 1
        },
        "runner_arch": {
          "type": "string",
          "minLength": 1
        },
        "local_elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "span_digest": {
          "$ref": "#/$defs/sha256"
        },
        "record_digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
