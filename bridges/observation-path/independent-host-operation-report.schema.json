{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/independent-host-operation-report.schema.json",
  "title": "Independent hosted-host operation-path reconstruction report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "path_id", "attempt_id", "repository", "run_id", "run_attempt", "workflow_ref", "workflow_sha", "source", "receiver", "host_separation", "causal_reconstruction", "duration", "limitations", "report_digest"],
  "properties": {
    "schema": {"const": "in-formation.independent-host-operation-report/0.1"},
    "path_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "repository": {"const": "Kier73/In-Formation-Space"},
    "run_id": {"type": "string"},
    "run_attempt": {"type": "string"},
    "workflow_ref": {"type": "string"},
    "workflow_sha": {"type": "string"},
    "source": {"$ref": "#/$defs/hostReport"},
    "receiver": {"$ref": "#/$defs/hostReport"},
    "host_separation": {
      "type": "object", "additionalProperties": false,
      "required": ["distinct_jobs", "distinct_temporal_actors", "both_github_hosted", "verification_host_is_third_job", "cross_os", "artifact_relay", "relay_channel_id"],
      "properties": {
        "distinct_jobs": {"type": "boolean"},
        "distinct_temporal_actors": {"type": "boolean"},
        "both_github_hosted": {"type": "boolean"},
        "verification_host_is_third_job": {"type": "boolean"},
        "cross_os": {"type": "boolean"},
        "artifact_relay": {"type": "string"},
        "relay_channel_id": {"type": "string"}
      }
    },
    "causal_reconstruction": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "edge_count", "edge_basis", "sender_vector", "receiver_vector", "sender_lamport", "receiver_lamport", "predecessor_span_digest", "successor_span_digest", "handoff_digest", "topological_order"],
      "properties": {
        "status": {"const": "verified_from_independent_attested_host_records"},
        "edge_count": {"const": 1},
        "edge_basis": {"type": "string"},
        "sender_vector": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "receiver_vector": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "sender_lamport": {"type": "integer", "minimum": 0},
        "receiver_lamport": {"type": "integer", "minimum": 0},
        "predecessor_span_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "successor_span_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "handoff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "topological_order": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "duration": {
      "type": "object", "additionalProperties": false,
      "required": ["source_local_elapsed_ns", "receiver_local_elapsed_ns", "combined_cross_host_elapsed_ns", "status"],
      "properties": {
        "source_local_elapsed_ns": {"type": "integer", "minimum": 0},
        "receiver_local_elapsed_ns": {"type": "integer", "minimum": 0},
        "combined_cross_host_elapsed_ns": {"type": "null"},
        "status": {"const": "not_computed_independent_unaligned_clock_domains"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["verified", "subject_sha256", "predicate_type", "signer_workflow", "source_ref", "self_hosted_runners_denied", "verified_signature_certificate_present", "verified_timestamp_count"],
      "properties": {
        "verified": {"const": true},
        "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "predicate_type": {"type": "string"},
        "signer_workflow": {"type": "string"},
        "source_ref": {"type": "string"},
        "self_hosted_runners_denied": {"const": true},
        "verified_signature_certificate_present": {"type": "boolean"},
        "verified_timestamp_count": {"type": "integer", "minimum": 0}
      }
    },
    "hostReport": {
      "type": "object", "additionalProperties": false,
      "required": ["job", "actor_id", "runner_name", "runner_os", "runner_arch", "local_elapsed_ns", "span_digest", "record_digest", "attestation"],
      "properties": {
        "job": {"type": "string"},
        "actor_id": {"type": "string"},
        "runner_name": {"type": "string"},
        "runner_os": {"type": "string"},
        "runner_arch": {"type": "string"},
        "local_elapsed_ns": {"type": "integer", "minimum": 0},
        "span_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attestation": {"$ref": "#/$defs/attestation"}
      }
    }
  }
}
