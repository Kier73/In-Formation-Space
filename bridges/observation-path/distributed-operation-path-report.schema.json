{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/distributed-operation-path-report.schema.json",
  "title": "Distributed operation path report",
  "description": "Conservative calibrated duration bounds for a vector-clock-ordered operation path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","path_id","attempt_id","reference_clock_id","reference_clock_actor_id","reference_clock_segment_id","operation_count","local_dependency_count","causal_handoff_count","aggregate_duration_lower_ns","aggregate_duration_upper_ns","critical_path_lower_ns","critical_path_upper_ns","critical_path_lower_span_digests","critical_path_upper_span_digests","critical_path_selection_status","clock_domain_profiles","calibration_digests","span_digests","trace_digest","causal_evidence_status","interpretation_limits","report_digest"],
  "properties": {
    "schema": {"const": "in-formation.distributed-operation-path-report/0.1"},
    "path_id": {"type": "string","minLength": 1},
    "attempt_id": {"type": "string","minLength": 1},
    "reference_clock_id": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "reference_clock_actor_id": {"type": "string","minLength": 1},
    "reference_clock_segment_id": {"type": "string","minLength": 1},
    "operation_count": {"type": "integer","minimum": 1},
    "local_dependency_count": {"type": "integer","minimum": 0},
    "causal_handoff_count": {"type": "integer","minimum": 0},
    "aggregate_duration_lower_ns": {"type": "integer","minimum": 0},
    "aggregate_duration_upper_ns": {"type": "integer","minimum": 0},
    "critical_path_lower_ns": {"type": "integer","minimum": 0},
    "critical_path_upper_ns": {"type": "integer","minimum": 0},
    "critical_path_lower_span_digests": {"type": "array","minItems": 1,"items": {"type": "string","pattern": "^[0-9a-f]{64}$"}},
    "critical_path_upper_span_digests": {"type": "array","minItems": 1,"items": {"type": "string","pattern": "^[0-9a-f]{64}$"}},
    "critical_path_selection_status": {"enum": ["same_extremal_chain","chain_identity_uncertain_under_calibration"]},
    "clock_domain_profiles": {"type": "array","items": {"type": "object","additionalProperties": false,"required": ["clock_domain_id","clock_actor_id","clock_segment_id","operation_count","native_duration_ns","reference_duration_lower_ns","reference_duration_upper_ns"],"properties": {"clock_domain_id": {"type": "string","pattern": "^[0-9a-f]{64}$"},"clock_actor_id": {"type": "string","minLength": 1},"clock_segment_id": {"type": "string","minLength": 1},"operation_count": {"type": "integer","minimum": 1},"native_duration_ns": {"type": "integer","minimum": 0},"reference_duration_lower_ns": {"type": "integer","minimum": 0},"reference_duration_upper_ns": {"type": "integer","minimum": 0}}}},
    "calibration_digests": {"type": "array","uniqueItems": true,"items": {"type": "string","pattern": "^[0-9a-f]{64}$"}},
    "span_digests": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"type": "string","pattern": "^[0-9a-f]{64}$"}},
    "trace_digest": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "causal_evidence_status": {"const": "vector_clock_consistent_unverified_transport"},
    "interpretation_limits": {"type": "array","minItems": 1,"items": {"type": "string","minLength": 1}},
    "report_digest": {"type": "string","pattern": "^[0-9a-f]{64}$"}
  }
}
