{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/observation-path.schema.json",
  "title": "In-Formation-Space Observation Path Record",
  "description": "One append-only request attempt. Structural validation is complemented by lifecycle validation in validate_observation_path.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "intent",
    "status",
    "terminal",
    "events"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_name",
        "query",
        "hypothesis_set_digest",
        "estimated_cost",
        "plan_ref"
      ],
      "properties": {
        "candidate_name": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "estimated_cost": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "plan_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "authority_required": {
          "type": "boolean"
        },
        "application_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "application_required": {
                "const": true
              }
            },
            "required": [
              "application_required"
            ]
          },
          "then": {
            "properties": {
              "authority_required": {
                "const": true
              }
            },
            "required": [
              "authority_required"
            ]
          }
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "dispatched",
        "admitted",
        "returned",
        "returned_unadmitted",
        "interpreted",
        "continued",
        "query_determined",
        "unresolved",
        "dispatch_failed",
        "rejected",
        "no_result",
        "interpretation_failed",
        "evidence_authorized",
        "evidence_refused",
        "applied",
        "application_failed"
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "actor",
          "clock_value",
          "clock_domain",
          "evidence_ref",
          "details"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "planned",
              "dispatched",
              "admitted",
              "returned",
              "returned_unadmitted",
              "interpreted",
              "continued",
              "query_determined",
              "unresolved",
              "dispatch_failed",
              "rejected",
              "no_result",
              "interpretation_failed",
              "evidence_authorized",
              "evidence_refused",
              "applied",
              "application_failed"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "clock_value": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "clock_domain": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "clock_value": {
                  "type": "string"
                }
              },
              "required": [
                "clock_value"
              ]
            },
            "then": {
              "properties": {
                "clock_domain": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "enum": [
                    "returned",
                    "returned_unadmitted"
                  ]
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "required": [
                "evidence_ref"
              ],
              "properties": {
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "details": {
                  "type": "object",
                  "required": [
                    "encounter_id",
                    "payload_digest",
                    "canonicalization"
                  ],
                  "properties": {
                    "encounter_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "canonicalization": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "interpreted"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "method"
                  ],
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "continued"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "next_attempt_id",
                    "next_candidate_name",
                    "hypothesis_set_digest"
                  ],
                  "properties": {
                    "next_attempt_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "next_candidate_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hypothesis_set_digest": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "query_determined"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "query_result",
                    "hypothesis_set_digest",
                    "basis"
                  ],
                  "properties": {
                    "query_result": {
                      "type": "boolean"
                    },
                    "hypothesis_set_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "enum": [
                    "dispatch_failed",
                    "rejected",
                    "no_result",
                    "interpretation_failed",
                    "unresolved"
                  ]
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "evidence_authorized"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "required": [
                "evidence_ref"
              ],
              "properties": {
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "details": {
                  "type": "object",
                  "required": [
                    "decision_status",
                    "policy_digest",
                    "decision_digest",
                    "quorum",
                    "strict",
                    "observed_sources",
                    "dissenting_sources",
                    "missing_sources",
                    "representative_source"
                  ],
                  "properties": {
                    "decision_status": {
                      "const": "AUTHORIZED"
                    },
                    "policy_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "decision_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quorum": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "strict": {
                      "type": "boolean"
                    },
                    "observed_sources": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dissenting_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "missing_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "representative_source": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "evidence_refused"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "required": [
                "evidence_ref"
              ],
              "properties": {
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "details": {
                  "type": "object",
                  "required": [
                    "decision_status",
                    "policy_digest",
                    "decision_digest",
                    "quorum",
                    "strict",
                    "observed_sources",
                    "dissenting_sources",
                    "missing_sources",
                    "reason"
                  ],
                  "properties": {
                    "decision_status": {
                      "enum": [
                        "CONFLICT",
                        "REFUSED"
                      ]
                    },
                    "policy_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "decision_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quorum": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "strict": {
                      "type": "boolean"
                    },
                    "observed_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dissenting_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "missing_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "applied"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "required": [
                "evidence_ref"
              ],
              "properties": {
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "details": {
                  "type": "object",
                  "required": [
                    "application_id",
                    "target_id",
                    "projection_digest",
                    "register_prefix"
                  ],
                  "properties": {
                    "application_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "projection_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "register_prefix": {
                      "type": "string",
                      "minLength": 1
                    },
                    "receiver_consumed_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "receiver_ack_emitted": {
                      "type": "boolean"
                    },
                    "checkpoint_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "application_failed"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
