{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/bridges/observation-path/observation-path.schema.json",
  "title": "In-Formation-Space Observation Path Record",
  "description": "One append-only request attempt. Structural validation is complemented by lifecycle validation in validate_observation_path.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "intent",
    "status",
    "terminal",
    "events"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_name",
        "query",
        "hypothesis_set_digest",
        "estimated_cost",
        "plan_ref"
      ],
      "properties": {
        "candidate_name": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "estimated_cost": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "plan_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "dispatched",
        "admitted",
        "returned",
        "returned_unadmitted",
        "interpreted",
        "continued",
        "query_determined",
        "unresolved",
        "dispatch_failed",
        "rejected",
        "no_result",
        "interpretation_failed"
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "actor",
          "clock_value",
          "clock_domain",
          "evidence_ref",
          "details"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "planned",
              "dispatched",
              "admitted",
              "returned",
              "returned_unadmitted",
              "interpreted",
              "continued",
              "query_determined",
              "unresolved",
              "dispatch_failed",
              "rejected",
              "no_result",
              "interpretation_failed"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "clock_value": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "clock_domain": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "clock_value": {
                  "type": "string"
                }
              },
              "required": [
                "clock_value"
              ]
            },
            "then": {
              "properties": {
                "clock_domain": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "enum": [
                    "returned",
                    "returned_unadmitted"
                  ]
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "required": [
                "evidence_ref"
              ],
              "properties": {
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "details": {
                  "type": "object",
                  "required": [
                    "encounter_id",
                    "payload_digest",
                    "canonicalization"
                  ],
                  "properties": {
                    "encounter_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "canonicalization": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "interpreted"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "method"
                  ],
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "continued"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "next_attempt_id",
                    "next_candidate_name",
                    "hypothesis_set_digest"
                  ],
                  "properties": {
                    "next_attempt_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "next_candidate_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hypothesis_set_digest": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "query_determined"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "query_result",
                    "hypothesis_set_digest",
                    "basis"
                  ],
                  "properties": {
                    "query_result": {
                      "type": "boolean"
                    },
                    "hypothesis_set_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "enum": [
                    "dispatch_failed",
                    "rejected",
                    "no_result",
                    "interpretation_failed",
                    "unresolved"
                  ]
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
