{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kier73/In-Formation-Space/blob/main/formats/encounter-envelope/schema.json",
  "title": "In-Formation Encounter Envelope experimental 0.1",
  "description": "Optional, non-normative envelope for preserving an encountered artifact separately from interpretations.",
  "type": "object",
  "required": ["format", "id", "source", "payload"],
  "properties": {
    "format": {"const": "in-formation.encounter/0.1"},
    "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "recorded_at": {"type": ["string", "null"], "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "name": {"type": ["string", "null"]},
        "reference": {"type": ["string", "null"]},
        "capture_method": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "context": {"type": "object", "additionalProperties": true},
    "payload": {
      "type": "object",
      "oneOf": [
        {"required": ["value"], "not": {"required": ["reference"]}},
        {"required": ["reference"], "not": {"required": ["value"]}}
      ],
      "properties": {
        "media_type": {"type": "string"},
        "value": {},
        "reference": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "encoding": {"type": "string"},
        "digest": {"type": "string"}
      },
      "additionalProperties": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "target"],
        "properties": {
          "kind": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "target": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {"type": "string"},
        "digest": {"type": "string"},
        "canonicalization": {"type": "string"}
      },
      "additionalProperties": true
    },
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
